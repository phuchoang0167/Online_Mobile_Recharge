flowchart TD
    %% See doc/data-flow/FLOWCHART_SYMBOLS.md for symbol meanings

    U[User]
    CV((Checkout View))
    HV((Transaction History + Pay Bill))
    PP[PayPal Sandbox]

    CC((CheckoutController))
    UTC((UserTransactionController))
    PAY((PaymentController))
    TS((TransactionService))
    ENS((EmailNotificationService))

    DB[(Transactions / Users / Cards / Products)]

    U --> CV --> CC --> TS --> DB
    DB --> TS --> CC

    CC --> ENS
    ENS --> U

    %% Pay bill: Card flow (settle immediately)
    U --> HV --> UTC --> TS --> DB
    DB --> TS --> UTC --> HV

    %% Pay bill: PayPal flow (begin checkout -> redirect -> return -> complete)
    UTC --> TS --> DB
    UTC --> PAY --> PP --> PAY --> TS --> DB
    DB --> TS --> PAY --> HV
