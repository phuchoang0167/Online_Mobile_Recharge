@model Online_Mobile_Recharge.Models.ViewModels.SettlePostpaidViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Pay Postpaid Bill";
}

<div class="content-panel">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
        <div>
            <h2 class="display-font mb-2">Pay Postpaid Bill</h2>
            <p class="text-muted mb-0">Use a saved card, or enter another card manually to close this bill.</p>
        </div>
        <a asp-controller="UserTransaction" asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>

    <form asp-controller="UserTransaction" asp-action="Pay" asp-route-id="@Model.TransactionId" method="post" class="row g-4" id="postpaidPayForm">
        <input asp-for="TransactionId" type="hidden" />

        <div class="col-lg-5">
            <div class="table-card h-100">
                <h5 class="mb-3">Bill Summary</h5>
                <p class="mb-2"><strong>Product:</strong> @Model.ProductName</p>
                <p class="mb-2"><strong>Phone Number:</strong> @Model.PhoneNumber</p>
                <p class="mb-2"><strong>Amount Due:</strong> @Model.Amount.ToString("N0") VND</p>
                <p class="mb-0"><strong>Due Date:</strong> @(Model.DueDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</p>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="table-card h-100">
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="alert alert-light border mb-3">
                    Your payment is validated against the cards you saved in the dashboard.
                </div>

                @if (Model.SavedCards != null && Model.SavedCards.Any())
                {
                    <div class="table-card mb-3">
                        <strong class="d-block mb-2">Card</strong>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="CardInputMode"
                                   id="billCardModeSaved"
                                   value="saved"
                                   @(string.Equals(Model.CardInputMode, "saved", StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                            <label class="form-check-label" for="billCardModeSaved">Use saved card</label>
                        </div>

                        <div id="billSavedCardPicker" class="mt-2">
                            <label asp-for="SavedCardId" class="form-label">Saved cards</label>
                            <select asp-for="SavedCardId"
                                    class="form-select"
                                    asp-items='@(new SelectList(Model.SavedCards, "Id", "Label", Model.SavedCardId))'>
                            </select>
                            <span asp-validation-for="SavedCardId" class="text-danger"></span>
                        </div>

                        <div class="form-check mt-3">
                            <input class="form-check-input"
                                   type="radio"
                                   name="CardInputMode"
                                   id="billCardModeManual"
                                   value="manual"
                                   @(string.Equals(Model.CardInputMode, "manual", StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                            <label class="form-check-label" for="billCardModeManual">Use another card</label>
                        </div>

                        <div class="small text-muted mt-2">
                            Manual card must match one of your saved cards.
                        </div>
                    </div>
                }
                else
                {
                    <input asp-for="CardInputMode" type="hidden" value="manual" />
                }

                <div id="billManualCardFields">
                    <div class="mb-3">
                        <label asp-for="CardNumber" class="form-label">Card Number</label>
                        <input asp-for="CardNumber" class="form-control" placeholder="16 digits" inputmode="numeric" />
                        <span asp-validation-for="CardNumber" class="text-danger"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Expiry" class="form-label">Expiry</label>
                            <input asp-for="Expiry" class="form-control" placeholder="MM/YY" inputmode="numeric" />
                            <span asp-validation-for="Expiry" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CVV" class="form-label">CVV</label>
                            <input asp-for="CVV" class="form-control" placeholder="3 digits" inputmode="numeric" />
                            <span asp-validation-for="CVV" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="status-note mb-3">
                    Your card will only be charged after you confirm. Once completed, this bill will be marked as <strong>Success</strong>.
                </div>

                <button type="submit" class="btn btn-brand btn-lg w-100">Confirm Bill Payment</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("postpaidPayForm");
            const cardModeSaved = document.getElementById("billCardModeSaved");
            const cardModeManual = document.getElementById("billCardModeManual");
            const savedCardPicker = document.getElementById("billSavedCardPicker");
            const savedCardSelect = document.getElementById("SavedCardId");
            const manualFields = document.getElementById("billManualCardFields");
            const cardNumberInput = document.getElementById("CardNumber");
            const expiryInput = document.getElementById("Expiry");
            const cvvInput = document.getElementById("CVV");

            if (!form) {
                return;
            }

            function toggleCardMode() {
                if (!savedCardSelect || !manualFields) {
                    return;
                }

                const useSaved = !!(cardModeSaved && cardModeSaved.checked);

                if (savedCardPicker) {
                    savedCardPicker.classList.toggle("d-none", !useSaved);
                }

                manualFields.classList.toggle("d-none", useSaved);
                savedCardSelect.disabled = !useSaved;

                [cardNumberInput, expiryInput, cvvInput].forEach(function (input) {
                    if (input) {
                        input.disabled = useSaved;
                    }
                });
            }

            if (cardModeSaved) {
                cardModeSaved.addEventListener("change", toggleCardMode);
            }

            if (cardModeManual) {
                cardModeManual.addEventListener("change", toggleCardMode);
            }

            form.addEventListener("submit", function (event) {
                const message = "Are you sure you want to pay this postpaid bill of " +
                    "@Model.Amount.ToString("N0") VND for @Model.PhoneNumber?";

                if (form.dataset.confirmed === "true") {
                    form.dataset.confirmed = "false";
                    return;
                }

                event.preventDefault();

                if (typeof window.showAppConfirm !== "function") {
                    form.dataset.confirmed = "true";
                    form.requestSubmit();
                    return;
                }

                window.showAppConfirm({
                    title: "Pay postpaid bill",
                    message: message,
                    onConfirm: function () {
                        form.dataset.confirmed = "true";
                        form.requestSubmit();
                    }
                });
            });

            toggleCardMode();
        });
    </script>
}
