@{
    ViewData["Title"] = "How It Works";
}

<section class="page-shell">
    <div class="hero-banner compact-banner fade-in-up">
        <div class="d-grid gap-3">
            <span class="eyebrow">Simple flow</span>
            <h1 class="display-font">Three steps from product selection to confirmed service.</h1>
            <p class="lead-copy">
                The platform is designed to keep common telecom actions short, clear, and easy to follow whether users
                are topping up prepaid numbers or settling postpaid bills.
            </p>
        </div>

        <div class="info-card">
            <strong>Best used for</strong>
            <p class="mb-0">Quick prepaid orders, postpaid bill tracking, service add-ons, and account self-service.</p>
        </div>
    </div>

    <div class="feature-grid">
        <article class="feature-card">
            <div class="feature-icon"><i class="bi bi-search"></i></div>
            <h5>1. Browse and choose</h5>
            <p class="mb-0">Users open the product catalog, compare packages, and pick the service that matches their current need.</p>
        </article>

        <article class="feature-card">
            <div class="feature-icon"><i class="bi bi-credit-card"></i></div>
            <h5>2. Confirm and pay</h5>
            <p class="mb-0">Checkout guides the user through phone number review, payment confirmation, and either prepaid or postpaid flow.</p>
        </article>

        <article class="feature-card">
            <div class="feature-icon"><i class="bi bi-receipt-cutoff"></i></div>
            <h5>3. Track and manage</h5>
            <p class="mb-0">After payment, users can review transaction history, leave feedback, and manage add-on services from the dashboard.</p>
        </article>

        <article class="feature-card">
            <div class="feature-icon"><i class="bi bi-headset"></i></div>
            <h5>Need support?</h5>
            <p class="mb-0">Users can open FAQ, send a support request, or review admin replies directly from the website.</p>
        </article>
    </div>

    <div class="content-panel">
        <div class="section-header-row mb-3">
            <div>
                <span class="eyebrow">Flow details</span>
                <h2 class="section-heading display-font">What users can expect during the process</h2>
            </div>
        </div>

        <div class="support-list">
            <div class="support-item">
                <h5>Prepaid purchase</h5>
                <p class="mb-0">Choose a product, enter the target phone number, confirm payment, and receive a successful transaction record.</p>
            </div>
            <div class="support-item">
                <h5>Postpaid billing</h5>
                <p class="mb-0">Create the bill first, then return later to complete payment from transaction history by entering the card details manually.</p>
            </div>
            <div class="support-item">
                <h5>After-sales actions</h5>
                <p class="mb-0">Users can review their order history, leave product feedback, update profile details, and manage telecom services.</p>
            </div>
        </div>
    </div>
</section>
