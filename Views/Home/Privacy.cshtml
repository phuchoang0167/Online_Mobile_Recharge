@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="page-shell">
    <div class="hero-banner compact-banner fade-in-up">
        <div class="d-grid gap-3">
            <span class="eyebrow">Privacy</span>
            <h1 class="display-font">How user data is handled across account, payment, and support flows.</h1>
            <p class="lead-copy">
                This privacy page outlines the main types of information collected by the platform and the purpose of
                using that information during account and transaction activities.
            </p>
        </div>

        <div class="info-card">
            <strong>Short version</strong>
            <p class="mb-0">Only the data needed for account access, orders, and support handling should be collected and displayed.</p>
        </div>
    </div>

    <div class="content-panel">
        <div class="policy-grid">
            <article class="policy-card">
                <h5>Account information</h5>
                <p class="mb-0">The platform stores basic user details such as name, email, phone number, password hash, and account status.</p>
            </article>
            <article class="policy-card">
                <h5>Transaction records</h5>
                <p class="mb-0">Recharge and bill-payment history is kept so users and admins can review status, timing, and related product details.</p>
            </article>
            <article class="policy-card">
                <h5>Support submissions</h5>
                <p class="mb-0">Messages from contact forms and product feedback are stored to improve service quality and answer user questions.</p>
            </article>
            <article class="policy-card">
                <h5>Email usage</h5>
                <p class="mb-0">Email addresses may be used for account verification, password reset, payment confirmation, and service reminders.</p>
            </article>
            <article class="policy-card">
                <h5>Access control</h5>
                <p class="mb-0">Admins can review operational data required for management, while users should only access records that belong to their own account.</p>
            </article>
            <article class="policy-card">
                <h5>Data updates</h5>
                <p class="mb-0">Users can review and update profile information from their dashboard, subject to platform rules and audit needs.</p>
            </article>
        </div>
    </div>
</section>
