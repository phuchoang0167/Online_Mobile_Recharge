@{
    ViewData["Title"] = "Terms of Service";
}

<section class="page-shell">
    <div class="hero-banner compact-banner fade-in-up">
        <div class="d-grid gap-3">
            <span class="eyebrow">Terms</span>
            <h1 class="display-font">Simple service terms and self-service use.</h1>
            <p class="lead-copy">
                These terms explain how users access the platform, use telecom services, submit payments, and interact
                with feedback and support features.
            </p>
        </div>

        <div class="info-card">
            <strong>Important note</strong>
            <p class="mb-0">This project is built for educational and purposes, but the service rules are presented in a practical web format.</p>
        </div>
    </div>

    <div class="content-panel">
        <div class="policy-grid">
            <article class="policy-card">
                <h5>Account responsibility</h5>
                <p class="mb-0">Users are responsible for providing correct profile details, protecting login credentials, and using the platform lawfully.</p>
            </article>
            <article class="policy-card">
                <h5>Payments and billing</h5>
                <p class="mb-0">All orders should be reviewed before confirmation. Postpaid bills remain pending until they are settled successfully.</p>
            </article>
            <article class="policy-card">
                <h5>Feedback and support</h5>
                <p class="mb-0">Users may leave feedback for purchased products and contact support through the website. Admin replies are provided for review purposes.</p>
            </article>
            <article class="policy-card">
                <h5>Service availability</h5>
                <p class="mb-0">The platform may be updated, adjusted, or temporarily unavailable during maintenance, testing, or feature improvements.</p>
            </article>
            <article class="policy-card">
                <h5>Acceptable use</h5>
                <p class="mb-0">Users must not abuse forms, submit fraudulent transactions, or attempt to interfere with the system, data, or other accounts.</p>
            </article>
            <article class="policy-card">
                <h5>Educational scope</h5>
                <p class="mb-0">The site demonstrates a telecom service workflow and does not represent a fully licensed commercial telecom operator.</p>
            </article>
        </div>
    </div>
</section>
