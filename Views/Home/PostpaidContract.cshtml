@{
    ViewData["Title"] = "Postpaid Purchase Contract";
}

<div class="container mt-5">
    <div class="hero-panel">
        <span class="eyebrow">Contract</span>
        <h1 class="display-font">Postpaid purchase contract (sample)</h1>
        <p class="text-muted mb-0">
            This page describes the basic purchase contract for creating and settling postpaid bills on this platform.
            Update this content to match your legal wording and local requirements.
        </p>
    </div>

    <div class="policy-grid mt-4">
        <article class="policy-card">
            <h5>1. Parties</h5>
            <p class="mb-0">The buyer is the account owner. The seller is the platform operator providing bill creation and settlement services.</p>
        </article>
        <article class="policy-card">
            <h5>2. Service scope</h5>
            <p class="mb-0">Postpaid checkout creates a pending bill with a due date. You can settle it later from your transaction history.</p>
        </article>
        <article class="policy-card">
            <h5>3. Payment &amp; due date</h5>
            <p class="mb-0">Bills must be paid before the due date. Overdue bills may restrict account usage according to the terms.</p>
        </article>
        <article class="policy-card">
            <h5>4. Customer data</h5>
            <p class="mb-0">National ID / CCCD and billing address are used for invoice and verification purposes.</p>
        </article>
    </div>
</div>

