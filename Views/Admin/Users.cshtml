@model List<Online_Mobile_Recharge.Models.Entities.User>
@using System.Linq

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "User Management";
}

<div class="content-panel">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
        <div>
            <h2 class="display-font mb-2">User Management</h2>
            <p class="text-muted mb-0">Review accounts, update profile details, and lock or remove non-admin users when needed.</p>
        </div>
        <div class="soft-pill">@Model.Count(x => x.Role != "Admin") users</div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 app-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th style="width: 220px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    if (item.Role == "Admin")
                    {
                        continue;
                    }

                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Locked</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="EditUser"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Edit
                                </a>

                                <form asp-action="ToggleUser" method="post" class="d-inline" data-confirm-title="Update user status" data-confirm-message="Are you sure you want to @(item.IsActive ? "lock" : "unlock") this user?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        @(item.IsActive ? "Lock" : "Unlock")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
