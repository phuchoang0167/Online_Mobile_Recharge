@model List<Online_Mobile_Recharge.Models.Entities.Product>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Products";
    var pricingByProductId = ViewBag.PricingByProductId as Dictionary<int, Online_Mobile_Recharge.Models.ViewModels.ProductPricingInfoViewModel>
        ?? new Dictionary<int, Online_Mobile_Recharge.Models.ViewModels.ProductPricingInfoViewModel>();
    var q = (ViewBag.Query as string) ?? string.Empty;
    var type = (ViewBag.Type as string) ?? string.Empty;
}

<div class="content-panel">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
        <div>
            <h3 class="display-font mb-1">Products</h3>
            <p class="text-muted mb-0">Manage packs and recharge options shown across the site.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-12 col-md-7">
            <label class="form-label mb-1">Search</label>
            <input name="q" value="@q" class="form-control" placeholder="Name / description" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label mb-1">Type</label>
            <select name="type" class="form-select">
                <option value="" selected="@(string.IsNullOrWhiteSpace(type))">All</option>
                @foreach (var item in Html.GetEnumSelectList<Online_Mobile_Recharge.Models.Enums.ProductType>())
                {
                    <option value="@item.Value" selected="@(string.Equals(type, item.Value, StringComparison.OrdinalIgnoreCase))">@item.Text</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-brand w-100">Filter</button>
            <a asp-action="Products" class="btn btn-outline-secondary w-100">Reset</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">No products found.</div>
    }
    else
    {
        @foreach (var group in Model.GroupBy(x => x.Type).OrderBy(x => x.Key.ToString()))
        {
            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mt-4 mb-2">
                <h5 class="mb-0">@group.Key packs</h5>
                <span class="soft-pill">@group.Count() items</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 app-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th class="text-end">Price</th>
                            <th>Flags</th>
                            <th style="width: 140px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in group)
                        {
                            <tr>
                                <td style="min-width: 260px;">
                                    <strong>@item.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="small text-muted">@item.Description</div>
                                    }
                                </td>
                                <td class="text-end">
                                    @{ pricingByProductId.TryGetValue(item.Id, out var pricing); }
                                    @if (pricing?.HasSale == true)
                                    {
                                        <div class="d-flex flex-column align-items-end">
                                            <span class="text-muted text-decoration-line-through small">@pricing.OriginalPrice.ToString("N0") VND</span>
                                            <span class="fw-bold text-danger">@pricing.EffectivePrice.ToString("N0") VND</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span>@item.Price.ToString("N0") VND</span>
                                    }
                                </td>
                                <td>
                                    @if (pricing?.HasSale == true)
                                    {
                                        <span class="badge bg-danger">Sale @pricing.SaleBadgeText</span>
                                    }
                                    @if (item.IsTop)
                                    {
                                        <span class="badge bg-primary">Top</span>
                                    }
                                    @if (item.IsSpecial)
                                    {
                                        <span class="badge bg-warning text-dark">Special</span>
                                    }
                                    @if (!item.IsTop && !item.IsSpecial)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
