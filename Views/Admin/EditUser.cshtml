@model Online_Mobile_Recharge.Models.Entities.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="content-panel">
    <h3 class="display-font mb-3">Edit User</h3>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="EditUser" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label>Name</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Phone</label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>

        <div class="mb-3">
            <label>National ID / CCCD</label>
            <input asp-for="NationalId" class="form-control" inputmode="numeric" />
        </div>

        <div class="mb-3">
            <label>Billing address</label>
            <input asp-for="BillingAddress" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Password (leave blank to keep old)</label>
            <input asp-for="Password" type="password" class="form-control" />
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-brand">Save</button>
            <a asp-controller="Admin" asp-action="Users" class="btn btn-secondary">Back</a>
        </div>
    </form>
</div>
