@model Online_Mobile_Recharge.Models.Entities.Product
@using Online_Mobile_Recharge.Models.Enums
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Edit Product";
}

<div class="content-panel">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
        <div>
            <h3 class="display-font mb-1">Edit product</h3>
            <p class="text-muted mb-0">Update pack information, price, and flags used on the homepage.</p>
        </div>
        <a asp-action="Products" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>

    <form asp-action="EditProduct" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-12">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </div>
        <input type="hidden" asp-for="Id" />

        <div class="col-lg-6">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" maxlength="150" required />
        </div>

        <div class="col-lg-3">
            <label asp-for="Type" class="form-label">Type</label>
            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<ProductType>()"></select>
        </div>

        <div class="col-lg-3">
            <label asp-for="Price" class="form-label">Price (VND)</label>
            <input asp-for="Price" type="number" step="1000" min="0" class="form-control" required />
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
        </div>

        <div class="col-12">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" asp-for="IsTop" />
                <label class="form-check-label" asp-for="IsTop">Top (prioritize on home)</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" asp-for="IsSpecial" />
                <label class="form-check-label" asp-for="IsSpecial">Special (highlight)</label>
            </div>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-brand">Save</button>
            <a asp-action="Products" class="btn btn-outline-dark">Cancel</a>
        </div>
    </form>
</div>
