@model Online_Mobile_Recharge.Models.Entities.ProductSale
@using Online_Mobile_Recharge.Models.Enums
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Create Sale";
}

<div class="content-panel">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
        <div>
            <h3 class="display-font mb-1">Create sale</h3>
            <p class="text-muted mb-0">Create a new sale campaign for a product.</p>
        </div>
        <a asp-action="Sales" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>

    <form asp-action="CreateSale" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-12">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </div>

        <div class="col-lg-6">
            <label asp-for="ProductId" class="form-label">Product</label>
            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products"></select>
            <span asp-validation-for="ProductId" class="text-danger"></span>
        </div>

        <div class="col-lg-3">
            <label asp-for="SaleType" class="form-label">Sale Type</label>
            <select asp-for="SaleType" class="form-select" asp-items="Html.GetEnumSelectList<ProductSaleType>()"></select>
            <span asp-validation-for="SaleType" class="text-danger"></span>
        </div>

        <div class="col-lg-3">
            <label asp-for="SaleValue" class="form-label">Sale Value</label>
            <input asp-for="SaleValue" type="number" step="1" min="0" class="form-control" />
            <div class="form-text">Percent: 1-100. Fixed amount: VND.</div>
            <span asp-validation-for="SaleValue" class="text-danger"></span>
        </div>

        <div class="col-lg-6">
            <label asp-for="StartAt" class="form-label">Start</label>
            <input asp-for="StartAt" type="datetime-local" class="form-control" />
            <span asp-validation-for="StartAt" class="text-danger"></span>
        </div>

        <div class="col-lg-6">
            <label asp-for="EndAt" class="form-label">End</label>
            <input asp-for="EndAt" type="datetime-local" class="form-control" />
            <span asp-validation-for="EndAt" class="text-danger"></span>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-brand">Create</button>
            <a asp-action="Sales" class="btn btn-outline-dark">Cancel</a>
        </div>
    </form>
</div>

