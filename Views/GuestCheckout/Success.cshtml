@model Online_Mobile_Recharge.Models.Entities.Transaction

@{
    ViewData["Title"] = "Payment Success";
}

<div class="content-panel">
    <div class="d-flex align-items-center gap-2 mb-2">
        <span class="ui-icon-bubble soft-success"><i class="bi bi-check-circle"></i></span>
        <h2 class="display-font mb-0">Topup completed</h2>
    </div>

    <p class="text-muted mb-4">Your guest topup payment was processed successfully.</p>

    <div class="table-card">
        <div class="d-flex justify-content-between">
            <span class="text-muted">Transaction</span>
            <strong>#@Model.Id</strong>
        </div>
        <div class="d-flex justify-content-between mt-2">
            <span class="text-muted">Phone</span>
            <strong>@Model.PhoneNumber</strong>
        </div>
        <div class="d-flex justify-content-between mt-2">
            <span class="text-muted">Amount</span>
            <strong class="text-danger">@Model.Amount.ToString("N0") VND</strong>
        </div>
        <div class="d-flex justify-content-between mt-2">
            <span class="text-muted">Status</span>
            <strong>@Model.Status</strong>
        </div>
        <div class="d-flex justify-content-between mt-2">
            <span class="text-muted">Created</span>
            <strong>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</strong>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <a asp-controller="Product" asp-action="Index" class="btn btn-brand">Back to products</a>
    </div>
</div>
