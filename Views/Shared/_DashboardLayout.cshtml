@inject Online_Mobile_Recharge.Services.NotificationService NotificationService

@{
    var role = Context.Session.GetString("Role");
    var userId = Context.Session.GetInt32("UserId");
    var bell = await NotificationService.BuildAsync(userId, role);
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="site-shell">
    <div class="dashboard-shell">
        <aside class="dashboard-sidebar">
            <a asp-controller="Home" asp-action="Index" class="dashboard-brand">
                <span class="brand-mark">M</span>
                <div>
                    <strong class="display-font d-block">Recharge Hub</strong>
                    <small class="text-white-50">@role workspace</small>
                </div>
            </a>

            @await Html.PartialAsync("_Sidebar", role)
        </aside>

        <main class="dashboard-main">
            <div class="dashboard-topbar">
                <div class="page-intro">
                    <h1>@pageTitle</h1>
                    <p>Manage your account, telecom services, and transaction flow from one place.</p>
                </div>

                <div class="topbar-actions d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-outline-dark nav-btn" id="sidebarToggle" aria-label="Toggle sidebar">
                        <i class="bi bi-layout-sidebar-inset"></i>
                    </button>
                    @await Html.PartialAsync("_NotificationBell", bell)
                    <span class="user-chip user-chip-dashboard">
                        <i class="bi bi-shield-check"></i>
                        <span>@role</span>
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger nav-btn">Logout</button>
                    </form>
                </div>
            </div>

            @RenderBody()
        </main>
    </div>

    <partial name="_ConfirmModal" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalElement = document.getElementById("appConfirmModal");
            if (!modalElement || typeof bootstrap === "undefined") {
                return;
            }

            const modal = new bootstrap.Modal(modalElement);
            const titleElement = document.getElementById("appConfirmModalTitle");
            const messageElement = document.getElementById("appConfirmModalMessage");
            const acceptButton = document.getElementById("appConfirmModalAccept");
            let pendingAction = null;

            window.showAppConfirm = function (options) {
                pendingAction = options.onConfirm || null;
                titleElement.textContent = options.title || "Please confirm";
                messageElement.textContent = options.message || "Are you sure you want to continue?";
                acceptButton.textContent = options.confirmText || "Confirm";
                modal.show();
            };

            acceptButton.addEventListener("click", function () {
                const action = pendingAction;
                pendingAction = null;
                modal.hide();

                if (typeof action === "function") {
                    action();
                }
            });

            modalElement.addEventListener("hidden.bs.modal", function () {
                pendingAction = null;
            });

            document.addEventListener("submit", function (event) {
                const form = event.target;
                if (!(form instanceof HTMLFormElement)) {
                    return;
                }

                const message = form.dataset.confirmMessage;
                if (!message) {
                    return;
                }

                if (form.dataset.confirmed === "true") {
                    form.dataset.confirmed = "false";
                    return;
                }

                event.preventDefault();

                window.showAppConfirm({
                    title: form.dataset.confirmTitle || "Please confirm",
                    message: message,
                    onConfirm: function () {
                        form.dataset.confirmed = "true";
                        form.requestSubmit();
                    }
                });
            });

            document.querySelectorAll(".notification-bell").forEach(function (bell) {
                const trigger = bell.querySelector(".bell-trigger");
                const badge = bell.querySelector(".bell-badge");

                if (!trigger || !badge) {
                    return;
                }

                const storageKey = trigger.dataset.bellStorageKey;
                const cookieKey = trigger.dataset.bellCookieKey;
                const signature = trigger.dataset.bellSignature;

                function getCookieValue(name) {
                    const cookie = document.cookie
                        .split("; ")
                        .find(function (entry) { return entry.startsWith(name + "="); });

                    return cookie ? decodeURIComponent(cookie.split("=").slice(1).join("=")) : null;
                }

                function setCookieValue(name, value) {
                    if (!name) {
                        return;
                    }

                    document.cookie = name + "=" + encodeURIComponent(value) + "; path=/; max-age=31536000; samesite=lax";
                }

                function syncReadState() {
                    if (!storageKey || !signature) {
                        return;
                    }

                    const seenSignature = window.localStorage.getItem(storageKey) || getCookieValue(cookieKey);
                    badge.classList.toggle("d-none", seenSignature === signature);
                }

                syncReadState();

                bell.addEventListener("shown.bs.dropdown", function () {
                    if (!storageKey || !signature) {
                        return;
                    }

                    window.localStorage.setItem(storageKey, signature);
                    setCookieValue(cookieKey, signature);
                    syncReadState();
                });
            });

            function initViewMore() {
                document.querySelectorAll("[data-view-more]").forEach(function (container) {
                    const initial = parseInt(container.dataset.viewMoreInitial || "10", 10);
                    const step = parseInt(container.dataset.viewMoreStep || String(initial), 10);
                    const items = Array.from(container.querySelectorAll("[data-view-more-item]"));
                    const button = container.querySelector("[data-view-more-button]");

                    if (!button) {
                        return;
                    }

                    if (items.length <= initial) {
                        button.classList.add("d-none");
                        return;
                    }

                    let shown = Math.max(1, initial);

                    function sync() {
                        items.forEach(function (item, index) {
                            item.classList.toggle("d-none", index >= shown);
                        });

                        button.classList.toggle("d-none", shown >= items.length);
                    }

                    sync();

                    button.addEventListener("click", function () {
                        shown = Math.min(items.length, shown + step);
                        sync();
                    });
                });
            }

            initViewMore();

            (function initSidebarCollapse() {
                const shell = document.querySelector(".dashboard-shell");
                const toggle = document.getElementById("sidebarToggle");
                if (!shell || !toggle) {
                    return;
                }

                const storageKey = "dashboardSidebarCollapsed";

                function setCollapsed(collapsed) {
                    shell.classList.toggle("is-collapsed", collapsed);
                    try {
                        window.localStorage.setItem(storageKey, collapsed ? "1" : "0");
                    } catch { }
                }

                let collapsed = false;
                try {
                    collapsed = window.localStorage.getItem(storageKey) === "1";
                } catch { }

                setCollapsed(collapsed);

                toggle.addEventListener("click", function () {
                    collapsed = !shell.classList.contains("is-collapsed");
                    setCollapsed(collapsed);
                });
            })();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
