@inject Online_Mobile_Recharge.Services.NotificationService NotificationService

@{
    var role = Context.Session.GetString("Role");
    var userId = Context.Session.GetInt32("UserId");
    var userName = Context.Session.GetString("Name");
    var selectedPhone = Context.Session.GetString("SelectedPhoneNumber") ?? string.Empty;
    var bell = await NotificationService.BuildAsync(userId, role);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Online Mobile Recharge")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="site-shell">
    <nav class="navbar navbar-expand-lg app-navbar py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">M</span>
                <span>Online Mobile Recharge</span>
            </a>

            <button class="navbar-toggler border-0 shadow-none text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-2"></i>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <div class="navbar-nav ms-lg-4 gap-lg-3">
                    <a asp-controller="Product" asp-action="Index" class="nav-link-custom @(currentController == "Product" ? "active" : string.Empty)">Products</a>
                    <a asp-controller="Feedback" asp-action="Index" class="nav-link-custom @(currentController == "Feedback" ? "active" : string.Empty)">Feedback</a>
                    <a asp-controller="Home" asp-action="About" class="nav-link-custom @(currentAction == "About" ? "active" : string.Empty)">About</a>
                    <a asp-controller="Home" asp-action="Contact" class="nav-link-custom @(currentAction == "Contact" ? "active" : string.Empty)">Contact</a>
                </div>

                <div class="ms-auto mt-3 mt-lg-0 d-flex align-items-center flex-wrap gap-2">
                    @if (userId != null)
                    {
                        @await Html.PartialAsync("_NotificationBell", bell)

                        if (role == "Admin")
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-accent">Admin</a>
                        }
                        else if (role == "User")
                        {
                            <a asp-controller="User" asp-action="Dashboard" class="btn btn-brand">Dashboard</a>
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light nav-btn">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-brand">Login</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-ghost-light">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <partial name="_ConfirmModal" />

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="display-font text-white">Recharge, bill pay, and manage services</h5>
                    <p class="mb-0">
                        A cleaner telecom experience for prepaid top-ups, postpaid bills, DND settings, and caller tune management.
                    </p>
                </div>

                <div class="col-md-4">
                    <h6 class="text-uppercase text-white-50 small">Quick links</h6>
                    <div class="d-grid gap-2">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Product" asp-action="Index">Products</a>
                        <a asp-controller="Home" asp-action="HowItWorks">How It Works</a>
                        <a asp-controller="Home" asp-action="Faq">FAQ</a>
                        <a asp-controller="Home" asp-action="Contact">Contact</a>
                    </div>
                </div>

                <div class="col-md-4">
                    <h6 class="text-uppercase text-white-50 small">Policies</h6>
                    <div class="d-grid gap-2">
                        <a asp-controller="Home" asp-action="About">About Us</a>
                        <a asp-controller="Home" asp-action="Terms">Terms of Service</a>
                        <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                        <a asp-controller="Home" asp-action="Sitemap">Sitemap</a>
                    </div>
                </div>
            </div>

            <div class="subtle-divider"></div>
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <span>© 2026 Online Mobile Recharge.</span>
                <span>Built for quick self-service telecom operations.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalElement = document.getElementById("appConfirmModal");
            if (!modalElement || typeof bootstrap === "undefined") {
                return;
            }

            const modal = new bootstrap.Modal(modalElement);
            const titleElement = document.getElementById("appConfirmModalTitle");
            const messageElement = document.getElementById("appConfirmModalMessage");
            const acceptButton = document.getElementById("appConfirmModalAccept");
            let pendingAction = null;

            window.showAppConfirm = function (options) {
                pendingAction = options.onConfirm || null;
                titleElement.textContent = options.title || "Please confirm";
                messageElement.textContent = options.message || "Are you sure you want to continue?";
                acceptButton.textContent = options.confirmText || "Confirm";
                modal.show();
            };

            acceptButton.addEventListener("click", function () {
                const action = pendingAction;
                pendingAction = null;
                modal.hide();

                if (typeof action === "function") {
                    action();
                }
            });

            modalElement.addEventListener("hidden.bs.modal", function () {
                pendingAction = null;
            });

            document.addEventListener("submit", function (event) {
                const form = event.target;
                if (!(form instanceof HTMLFormElement)) {
                    return;
                }

                const message = form.dataset.confirmMessage;
                if (!message) {
                    return;
                }

                if (form.dataset.confirmed === "true") {
                    form.dataset.confirmed = "false";
                    return;
                }

                event.preventDefault();

                window.showAppConfirm({
                    title: form.dataset.confirmTitle || "Please confirm",
                    message: message,
                    onConfirm: function () {
                        form.dataset.confirmed = "true";
                        form.requestSubmit();
                    }
                });
            });

            document.querySelectorAll(".notification-bell").forEach(function (bell) {
                const trigger = bell.querySelector(".bell-trigger");
                const badge = bell.querySelector(".bell-badge");

                if (!trigger || !badge) {
                    return;
                }

                const storageKey = trigger.dataset.bellStorageKey;
                const cookieKey = trigger.dataset.bellCookieKey;
                const signature = trigger.dataset.bellSignature;

                function getCookieValue(name) {
                    const cookie = document.cookie
                        .split("; ")
                        .find(function (entry) { return entry.startsWith(name + "="); });

                    return cookie ? decodeURIComponent(cookie.split("=").slice(1).join("=")) : null;
                }

                function setCookieValue(name, value) {
                    if (!name) {
                        return;
                    }

                    document.cookie = name + "=" + encodeURIComponent(value) + "; path=/; max-age=31536000; samesite=lax";
                }

                function syncReadState() {
                    if (!storageKey || !signature) {
                        return;
                    }

                    const seenSignature = window.localStorage.getItem(storageKey) || getCookieValue(cookieKey);
                    badge.classList.toggle("d-none", seenSignature === signature);
                }

                syncReadState();

                bell.addEventListener("shown.bs.dropdown", function () {
                    if (!storageKey || !signature) {
                        return;
                    }

                    window.localStorage.setItem(storageKey, signature);
                    setCookieValue(cookieKey, signature);
                    syncReadState();
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
