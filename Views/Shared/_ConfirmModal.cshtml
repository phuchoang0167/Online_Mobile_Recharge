<div class="modal fade app-confirm-modal" id="appConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div>
                    <span class="eyebrow">Confirmation</span>
                    <h5 class="modal-title mt-2 mb-0" id="appConfirmModalTitle">Please confirm</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="mb-0 text-muted" id="appConfirmModalMessage">Are you sure you want to continue?</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-brand" id="appConfirmModalAccept">Confirm</button>
            </div>
        </div>
    </div>
</div>
