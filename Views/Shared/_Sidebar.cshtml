@if (Model?.ToLower() == "user")
{
    <a asp-controller="Home" asp-action="Index" class="sidebar-link">
        <i class="bi bi-house-door"></i>
        <span>Home</span>
    </a>
    <a asp-controller="User" asp-action="Dashboard" class="sidebar-link">
        <i class="bi bi-speedometer2"></i>
        <span>Dashboard</span>
    </a>
    <a asp-controller="User" asp-action="Profile" class="sidebar-link">
