@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-5">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="content-panel h-100">
                <span class="badge text-bg-dark mb-3">Secure Checkout</span>
                <div class="d-flex align-items-center gap-3 mb-2">
                    <span class="ui-icon-bubble"><i class="bi bi-bag-check"></i></span>
                    <h3 class="display-font mb-0">@Model.ProductName</h3>
                </div>
                <p class="text-muted mb-4">Complete your order to activate the package quickly, track the status clearly, and manage payment history from your dashboard.</p>

                <div class="table-card mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Total amount</span>
                        @if (Model.HasSale)
                        {
                            <div class="d-flex flex-column align-items-end">
                                <span class="badge text-bg-danger align-self-end mb-1">Sale @Model.SaleBadgeText</span>
                                <span class="text-muted text-decoration-line-through small">@Model.OriginalPrice.ToString("N0") VND</span>
                                <strong class="fs-4 text-danger">@Model.Price.ToString("N0") VND</strong>
                            </div>
                        }
                        else
                        {
                            <strong class="fs-4 text-danger">@Model.Price.ToString("N0") VND</strong>
                        }
                    </div>
                </div>

                <div class="table-card mb-4">
                    <p class="mb-2"><strong>Account:</strong> @Model.UserName</p>
                    <p class="mb-2"><strong>Default phone:</strong> @(string.IsNullOrWhiteSpace(Model.DefaultPhone) ? "Not set" : Model.DefaultPhone)</p>
                    <p class="mb-0"><strong>Payment:</strong> Use a saved card from your dashboard, or enter a card manually for validation.</p>
                </div>

                <ul class="small text-muted ps-3 mb-0">
                    <li>Prepaid payments are validated against the cards you saved in `Dashboard > Cards`.</li>
                    <li>If you have saved cards, you can select one directly (no manual entry needed).</li>
                    <li>Postpaid creates a pending bill with a due date 7 days later.</li>
                </ul>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="content-panel">
                <h3 class="display-font mb-3">Payment</h3>

                <form asp-action="Review" method="post" class="d-grid gap-3" id="checkoutForm">
                    <input asp-for="ProductId" type="hidden" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger mb-0"></div>
                    }

                    <div>
                        <label asp-for="Type" class="form-label">Payment type</label>
                        <select asp-for="Type" class="form-select" id="typeSelect">
                            <option value="prepaid">Prepaid</option>
                            <option value="postpaid">Postpaid</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div id="postpaidExtraFields" class="d-none"></div>

                    @{
                        var manualPhoneValue = (Model.Phone ?? string.Empty).Trim();
                        var phoneOptions = (Model.PhoneOptions ?? new List<string>())
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .Select(x => x.Trim())
                            .Distinct(StringComparer.OrdinalIgnoreCase)
                            .ToList();
                        var hasMatch = phoneOptions.Any(x => string.Equals(x, manualPhoneValue, StringComparison.OrdinalIgnoreCase));
                        var initialSelection = hasMatch ? manualPhoneValue : "__manual__";
                    }

                    <div>
                        <label class="form-label" for="phoneSelect">Phone number</label>
                        <div class="table-card p-3 d-grid gap-2">
                            <select class="form-select" id="phoneSelect" aria-label="Select phone number">
                                @foreach (var phone in phoneOptions)
                                {
                                    <option value="@phone" selected="@(string.Equals(initialSelection, phone, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@phone</option>
                                }
                                <option value="__manual__" selected="@(string.Equals(initialSelection, "__manual__", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Other (enter a new number)</option>
                            </select>

                            <div id="phoneManualWrap">
                                <input asp-for="Phone" class="form-control" placeholder="0xxxxxxxxx" inputmode="numeric" autocomplete="tel" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div id="prepaidPaymentMethodWrap">
                        <label asp-for="PrepaidPaymentMethod" class="form-label">Payment method</label>
                        <select asp-for="PrepaidPaymentMethod" class="form-select" id="prepaidPaymentMethod">
                            <option value="card">Card (saved / manual)</option>
                            <option value="paypal">PayPal (Sandbox)</option>
                        </select>
                        <div class="small text-muted mt-1">PayPal runs in sandbox mode for testing (no real money).</div>
                    </div>

                    <div id="cardSection" class="d-grid gap-3">
                        @if (Model.SavedCards != null && Model.SavedCards.Any())
                        {
                            <div class="table-card mb-0">
                                <strong class="d-block mb-2">Card</strong>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="CardInputMode"
                                           id="cardModeSaved"
                                           value="saved"
                                           @(string.Equals(Model.CardInputMode, "saved", StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                                    <label class="form-check-label" for="cardModeSaved">Use saved card</label>
                                </div>

                                <div id="savedCardPicker" class="mt-2">
                                    <label asp-for="SavedCardId" class="form-label">Saved cards</label>
                                    <select asp-for="SavedCardId"
                                            class="form-select"
                                            asp-items='@(new SelectList(Model.SavedCards, "Id", "Label", Model.SavedCardId))'>
                                    </select>
                                    <span asp-validation-for="SavedCardId" class="text-danger"></span>
                                </div>

                                <div class="form-check mt-3">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="CardInputMode"
                                           id="cardModeManual"
                                           value="manual"
                                           @(string.Equals(Model.CardInputMode, "manual", StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                                    <label class="form-check-label" for="cardModeManual">Use another card</label>
                                </div>

                                <div class="small text-muted mt-2">
                                    Manual card must match one of your saved cards.
                                </div>
                            </div>
                        }
                        else
                        {
                            <input asp-for="CardInputMode" type="hidden" value="manual" />
                            <div class="alert alert-light border mb-0">
                                No saved cards found. Add a card in <a href="/User/Cards">Dashboard &gt; Cards</a>, or enter a card manually.
                            </div>
                        }

                        <div id="manualCardFields" class="d-grid gap-3">
                            <div>
                                <label asp-for="CardNumber" class="form-label">Card Number</label>
                                <input asp-for="CardNumber" class="form-control" placeholder="16 digits" inputmode="numeric" />
                                <span asp-validation-for="CardNumber" class="text-danger"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Expiry" class="form-label">Expiry</label>
                                    <input asp-for="Expiry" class="form-control" placeholder="MM/YY" inputmode="numeric" />
                                    <span asp-validation-for="Expiry" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="CVV" class="form-label">CVV</label>
                                    <input asp-for="CVV" class="form-control" placeholder="3 digits" inputmode="numeric" />
                                    <span asp-validation-for="CVV" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="postpaidNote" class="alert alert-warning mb-0 d-none">
                        A postpaid order will be created with <strong>Pending</strong> status and will appear in transaction history with a due date 7 days later.
                    </div>

                    <button type="submit" class="btn btn-brand btn-lg" id="checkoutSubmitButton">Review order</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const typeSelect = document.getElementById("typeSelect");
            const checkoutForm = document.getElementById("checkoutForm");
            const phoneHiddenInput = document.getElementById("Phone");
            const phoneSelect = document.getElementById("phoneSelect");
            const phoneManualWrap = document.getElementById("phoneManualWrap");
            const cardSection = document.getElementById("cardSection");
            const postpaidNote = document.getElementById("postpaidNote");
            const postpaidExtraFields = document.getElementById("postpaidExtraFields");
            const checkoutSubmitButton = document.getElementById("checkoutSubmitButton");
            const prepaidPaymentMethodWrap = document.getElementById("prepaidPaymentMethodWrap");
            const prepaidPaymentMethod = document.getElementById("prepaidPaymentMethod");
            const cardNumberInput = document.getElementById("CardNumber");
            const expiryInput = document.getElementById("Expiry");
            const cvvInput = document.getElementById("CVV");
            const cardModeSaved = document.getElementById("cardModeSaved");
            const cardModeManual = document.getElementById("cardModeManual");
            const savedCardPicker = document.getElementById("savedCardPicker");
            const savedCardSelect = document.getElementById("SavedCardId");
            const manualCardFields = document.getElementById("manualCardFields");

            function togglePaymentMode() {
                const isPostpaid = typeSelect.value === "postpaid";
                const prepaidMethod = prepaidPaymentMethod ? prepaidPaymentMethod.value : "card";
                const usingCard = prepaidMethod === "card";

                cardSection.classList.toggle("d-none", isPostpaid || !usingCard);
                postpaidNote.classList.toggle("d-none", !isPostpaid);
                if (postpaidExtraFields) {
                    postpaidExtraFields.classList.toggle("d-none", !isPostpaid);
                }
                checkoutSubmitButton.textContent = "Review order";

                if (prepaidPaymentMethodWrap) {
                    prepaidPaymentMethodWrap.classList.toggle("d-none", isPostpaid);
                }

                [cardNumberInput, expiryInput, cvvInput, savedCardSelect, cardModeSaved, cardModeManual].forEach(function (input) {
                    if (input) {
                        input.disabled = isPostpaid || !usingCard;
                    }
                });

                if (!isPostpaid) {
                    toggleCardMode();
                }
            }

            function toggleCardMode() {
                if (!savedCardSelect || !manualCardFields) {
                    return;
                }

                if (cardSection && cardSection.classList.contains("d-none")) {
                    if (savedCardSelect) {
                        savedCardSelect.disabled = true;
                    }

                    [cardNumberInput, expiryInput, cvvInput].forEach(function (input) {
                        if (input) {
                            input.disabled = true;
                        }
                    });

                    if (savedCardPicker) {
                        savedCardPicker.classList.add("d-none");
                    }

                    manualCardFields.classList.add("d-none");
                    return;
                }

                const useSaved = !!(cardModeSaved && cardModeSaved.checked);

                if (savedCardPicker) {
                    savedCardPicker.classList.toggle("d-none", !useSaved);
                }

                manualCardFields.classList.toggle("d-none", useSaved);

                if (savedCardSelect) {
                    savedCardSelect.disabled = !useSaved;
                }

                [cardNumberInput, expiryInput, cvvInput].forEach(function (input) {
                    if (input) {
                        input.disabled = useSaved;
                    }
                });
            }

            typeSelect.addEventListener("change", togglePaymentMode);
            if (prepaidPaymentMethod) {
                prepaidPaymentMethod.addEventListener("change", togglePaymentMode);
            }

            function syncPhoneFromSelector() {
                if (!phoneSelect || !phoneHiddenInput) {
                    return;
                }

                const isManual = phoneSelect.value === "__manual__";
                if (phoneManualWrap) {
                    phoneManualWrap.classList.toggle("d-none", !isManual);
                }

                if (!isManual) {
                    phoneHiddenInput.value = phoneSelect.value || "";
                }
            }

            if (phoneSelect) {
                phoneSelect.addEventListener("change", syncPhoneFromSelector);
                syncPhoneFromSelector();
            }

            if (cardModeSaved) {
                cardModeSaved.addEventListener("change", toggleCardMode);
            }

            if (cardModeManual) {
                cardModeManual.addEventListener("change", toggleCardMode);
            }

            if (checkoutForm) {
                checkoutForm.addEventListener("submit", function (event) {
                    const paymentType = typeSelect.value === "postpaid" ? "postpaid" : "prepaid";
                    const rawPhone = (phoneHiddenInput && phoneHiddenInput.value) ? phoneHiddenInput.value : "";
                    const maskedPhone = rawPhone && rawPhone.length >= 6
                        ? rawPhone.substring(0, 3) + "***" + rawPhone.substring(rawPhone.length - 3)
                        : "your phone number";
                    const message = typeSelect.value === "postpaid"
                        ? "Are you sure you want to create a postpaid bill for " + maskedPhone + "?"
                        : "Are you sure you want to confirm this " + paymentType + " payment for " + maskedPhone + "?";

                    if (checkoutForm.dataset.confirmed === "true") {
                        checkoutForm.dataset.confirmed = "false";
                        return;
                    }

                    event.preventDefault();

                    if (typeof window.showAppConfirm !== "function") {
                        checkoutForm.dataset.confirmed = "true";
                        checkoutForm.requestSubmit();
                        return;
                    }

                    window.showAppConfirm({
                        title: typeSelect.value === "postpaid" ? "Create postpaid bill" : "Confirm payment",
                        message: message,
                        onConfirm: function () {
                            checkoutForm.dataset.confirmed = "true";
                            checkoutForm.requestSubmit();
                        }
                    });
                });
            }
            togglePaymentMode();
        });
    </script>

}
