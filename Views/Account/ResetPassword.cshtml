@model Online_Mobile_Recharge.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section class="auth-shell">
    <div class="auth-card auth-card-compact">
        <div class="auth-panel">
            <div class="mb-4">
                <span class="eyebrow">Account Recovery</span>
                <h3 class="display-font mb-2 mt-3">Send a Password Reset Link</h3>
                <p class="text-muted mb-0">Enter your registered email address. We will send a token-based reset link that expires in 30 minutes.</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="d-grid gap-3">
                <div>
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control form-control-lg" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button class="btn btn-brand btn-lg" type="submit">Send Reset Link</button>
            </form>

            <div class="text-center mt-4 small">
                <a asp-action="Login">Back to sign in</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
