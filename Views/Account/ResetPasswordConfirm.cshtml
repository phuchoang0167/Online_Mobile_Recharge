@model Online_Mobile_Recharge.Models.ViewModels.ResetPasswordConfirmViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<section class="auth-shell">
    <div class="auth-card auth-card-compact">
        <div class="auth-panel">
            <div class="mb-4">
                <span class="eyebrow">Account Security</span>
                <h3 class="display-font mb-2 mt-3">Create a New Password</h3>
                <p class="text-muted mb-0">Set a new password to complete your account recovery.</p>
            </div>

            <form asp-action="ResetPasswordConfirm" method="post" class="d-grid gap-3">
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div>
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-control form-control-lg" placeholder="New password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="Confirm password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button class="btn btn-brand btn-lg" type="submit">Update Password</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
